# =============================================================================
# n8n-hubspot-custom-object-retention-archiver — environment template
# Copy to .env for local CLI runs (never commit .env). The n8n workflow reads
# the same variables through $env. Values that still start with YOUR_ count
# as "not set".
# =============================================================================

# --- Safety gates (SAFE DEFAULTS — keep them on until you have tested) -------
# DRY_RUN=true: fetch stale records and build the backup preview, but make
# ZERO writes to S3 / Google Sheets / files and ZERO HubSpot DELETE calls.
# Anything other than an explicit "false" keeps the gate on.
DRY_RUN=true

# SANDBOX_MODE=true: abort unless GET /account-info/v3/details reports
# accountType SANDBOX or DEVELOPER_TEST.
SANDBOX_MODE=true

# Hard ceiling on records archived per run (1-10000).
MAX_ARCHIVE_PER_RUN=500

# --- HubSpot ---------------------------------------------------------------
# Private App token. Scopes: crm.objects.custom.read, crm.objects.custom.write,
# crm.schemas.custom.read
HUBSPOT_ACCESS_TOKEN=YOUR_HUBSPOT_PRIVATE_APP_TOKEN
# Custom object only: objectTypeId (2-<id>) or fully qualified name (p<portal>_<name>)
CUSTOM_OBJECT_TYPE=YOUR_CUSTOM_OBJECT_TYPE
HUBSPOT_API_BASE=https://api.hubapi.com

# --- Retention rule ------------------------------------------------------------
# Records whose DATE_PROPERTY is older than RETENTION_DAYS (30-3650) are stale.
RETENTION_DAYS=365
DATE_PROPERTY=hs_lastmodifieddate
# Optional: a custom "last activity" date. If set, a record is stale only when
# this date is also older than the cutoff (or empty).
ACTIVITY_DATE_PROPERTY=
# Optional: a property that, when true/yes/1, protects a record (legal hold).
LEGAL_HOLD_PROPERTY=

# --- Cold storage (a verified backup is REQUIRED before any archive) -----------
# s3 | sheets | s3,sheets | file (file = CLI only, local write-once files)
STORAGE_TARGETS=s3

# AWS S3 (SigV4 signed natively; needs only s3:PutObject on the prefix)
AWS_S3_BUCKET=YOUR_AWS_S3_BUCKET
AWS_REGION=YOUR_AWS_REGION
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
# Optional: temporary credentials
AWS_SESSION_TOKEN=
AWS_S3_PREFIX=hubspot-retention-archive
# Optional: S3-compatible endpoint (path-style), e.g. https://s3.example-provider.test
AWS_S3_ENDPOINT=

# Google Sheets ledger (one row per archived record)
GOOGLE_SHEETS_ID=YOUR_GOOGLE_SHEETS_ID
GOOGLE_SHEETS_TAB=archive_ledger
# Either a service-account key (single-line JSON) ...
GOOGLE_SERVICE_ACCOUNT_JSON=YOUR_GOOGLE_SERVICE_ACCOUNT_JSON
# ... or a short-lived OAuth access token (overrides the service account)
GOOGLE_OAUTH_ACCESS_TOKEN=

# Local file target (CLI only)
BACKUP_DIR=reports/cold-storage
